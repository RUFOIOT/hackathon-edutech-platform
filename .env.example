# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repositorio.

# --- App ---
APP_BASE_URL=http://localhost:3000

# --- Firebase (cliente, públicos: identifican el proyecto, no dan acceso por sí solos) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true en desarrollo para usar los emuladores locales (auth 9099, firestore 8080, storage 9199)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Firebase Admin (servidor, SECRETOS) ---
# Cuenta de servicio: Consola de Firebase → Configuración → Cuentas de servicio → Generar clave.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave en una sola línea con los saltos como \n
FIREBASE_PRIVATE_KEY=

# Solo en desarrollo con emuladores (firebase-admin los detecta automáticamente):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- GitHub App instalada en la organización (Fase 4) ---
GITHUB_APP_ID=
# Clave privada PEM de la GitHub App, en una sola línea con \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=eight-academy-hackathon
GITHUB_WEBHOOK_SECRET=

# --- Seguridad y privacidad (Fase 8) ---
# Sal del hash de IP del límite de peticiones (rate_limits/). Cualquier valor aleatorio.
HASH_SALT=
# Meses tras el evento para anonimizar datos personales (por defecto 12).
# RETENCION_MESES=12

# --- Sitio estático para GitHub Pages (solo npm run build:pages) ---
# BASE_PATH=/hackathon-edutech-platform
# NEXT_PUBLIC_URL_PLATAFORMA=https://<app en Netlify>

# --- Check-in ---
# Secreto para firmar el QR personal de check-in (mínimo 32 caracteres aleatorios)
CHECKIN_QR_SECRET=

# --- Solo desarrollo y tests (se ignoran si no se usan los emuladores) ---
# Simula la fecha del servidor para ensayar fases (ISO con offset), p. ej. 2026-10-15T10:00:00-05:00
# APP_FECHA_SIMULADA=
# API de GitHub alternativa (servidor simulado en tests e2e)
# GITHUB_API_BASE=

# --- n8n (Fase 7, ver n8n/README.md) ---
# URL base de los webhooks de n8n; la app agrega /<evento>. Ej.: https://n8n.ejemplo.org/webhook
N8N_WEBHOOK_BASE_URL=
# Secreto compartido para HMAC-SHA256 en X-Signature (mínimo 32 caracteres aleatorios)
N8N_SHARED_SECRET=

# --- Correo (lo usa n8n como credencial "Resend API"; la app solo lo documenta) ---
RESEND_API_KEY=

# --- Solo para npm run n8n:test contra una app corriendo (opcional) ---
# N8N_TEST_APP_URL=http://localhost:3000
# N8N_TEST_APP_SECRET=
