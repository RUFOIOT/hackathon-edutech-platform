{
  "name": "WF-05 · Recordatorio de checkpoints",
  "nodes": [
    {
      "id": "c27502b0-5a15-4392-a64d-44ee1a6f92e8",
      "name": "Firmar consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "// Firma la petición hacia la app (X-Timestamp + X-Signature, lib/hmac.ts).\nconst crypto = require('crypto');\nconst secreto = $env.EDUTECH_SHARED_SECRET;\nreturn $input.all().map((item, i) => {\n  const peticion = item.json.peticion;\n  const cuerpo = JSON.stringify(peticion);\n  const ts = String(Math.floor(Date.now() / 1000));\n  const firma = 'sha256=' + crypto.createHmac('sha256', secreto).update(ts + '.' + cuerpo).digest('hex');\n  return { json: { contexto: item.json.contexto || null, cuerpo, ts, firma } };\n});"
      }
    },
    {
      "id": "10cb185a-cf88-4d13-a478-f068573cb741",
