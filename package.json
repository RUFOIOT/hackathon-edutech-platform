{
  "name": "hackathon-edutech-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore,storage --project demo-edutech \"vitest run --project rules\"",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:rules && npm run test:e2e",
    "emulators": "npx -y firebase-tools@15 emulators:start --project demo-edutech --import=.firebase-data --export-on-exit=.firebase-data",
    "seed": "tsx scripts/seed.ts",
    "plantilla:autorizacion": "tsx scripts/generar-plantilla-autorizacion.ts",
    "dataset:verificar": "tsx scripts/verificar-kpis.ts",
    "n8n:generar": "tsx scripts/generar-workflows.ts",
    "n8n:test": "tsx --conditions=react-server scripts/n8n-test.ts"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@zxing/browser": "^0.2.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "hast-util-to-string": "^3.0.1",
    "next": "^15.5.27",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "protobufjs@7.6.6": true
  }
}
